# Banglar Voice — autonomous newsroom worker env template
# Copy to worker/.env (local) or set on your host (prod):
#     cp .env.example .env
# NEVER commit the real .env.

# ── Supabase ────────────────────────────────────────────────────────────────
# Same project as the app (service-role key, SERVER ONLY).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ingest ──────────────────────────────────────────────────────────────
# Shared secret — must match the app's NEWSROOM_INGEST_KEY.
NEWSROOM_INGEST_KEY=change-me-openssl-rand-hex-32
# Live app base URL the worker POSTs drafts to.
# Local dev (after `npm run dev`): http://127.0.0.1:3000
BV_BASE_URL=http://127.0.0.1:3000

# ── News collection ─────────────────────────────────────────────────────────
# Comma-separated RSS/Atom feed URLs. Empty = built-in source list
# (Bangladesh national, politics, economy, sports, technology, entertainment,
# international via Google News RSS index).
NEWS_RSS_URLS=
# Loop interval in minutes (default 15). Minimum sensible: 10.
INTERVAL_MINUTES=15

# ── AI rewrite (copyright-free) ─────────────────────────────────────────────
# OpenAI-compatible endpoint used by the rewriter AND the app's chat hub.
#   OpenAI   https://api.openai.com/v1                  (gpt-4o-mini)
#   Gemini   https://generativelanguage.googleapis.com/v1beta/openai
#   Groq     https://api.groq.com/openai/v1             (llama-3.3-70b-versatile)
#   Ollama   http://127.0.0.1:11434/v1                  (llama3.1, self-hosted)
# Leave CHAT_AI_KEY empty → the rewriter falls back to a deterministic
# Bangla paraphrase engine (still copyright-free, still original prose).
CHAT_AI_KEY=
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_MODEL=gpt-4o-mini

# ── CC0 media sourcing ──────────────────────────────────────────────────────
# Wikimedia Commons + Openverse need NO key. Pexels is optional (better photos).
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Social broadcast (each missing credential → that platform is skipped) ──
# Facebook Page (Graph API): https://developers.facebook.com/apps
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# X / Twitter API v2 (OAuth 1.0a user context): https://developer.x.com
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Instagram (Facebook Graph API — professional account linked to the page)
INSTAGRAM_PAGE_ID=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_TOKEN=

# LinkedIn (shares API): https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Telegram (BotFather) — used for BOTH channel broadcast and the editorial
# command controller. /publish /approve /reject /status /sources /pause ...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated chat ids allowed to send commands (RECOMMENDED).
# Empty = any chat the bot can see may command it.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Editorial gate ──────────────────────────────────────────────────────────
# AUTO_PUBLISH=true  → every rewritten item publishes + broadcasts without a
#                      human (use only after you trust the rewriter + media).
# false (default)    → items wait in newsroom_queue / pipeline state for an
#                      editor; Telegram /approve <id> or /publish <id> moves them.
AUTO_PUBLISH=false

# Local JSON file that stores the pipeline state (rewritten text, media,
# broadcast log) so the loop is restart-safe. Relative to worker/ dir.
PIPELINE_STATE_FILE=pipeline-state.json
