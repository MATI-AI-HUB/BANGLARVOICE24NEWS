# Banglar Voice — 24/7 AI News Automation Worker
# Copy to .env and fill real values. NEVER commit real keys.

# --- Loop timing ------------------------------------------------------------
# How often the collector polls the RSS feeds (minutes). Min 10.
INTERVAL_MINUTES=15

# --- RSS sources ------------------------------------------------------------
# Comma-separated custom feed URLs. If empty, the built-in 7-category
# Google News RSS index (Bangladesh) is used.
NEWS_RSS_URLS=

# --- AI (OpenAI-compatible chat) --------------------------------------------
# Base URL for chat completions. Works with OpenAI, Gemini, Groq, Ollama.
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_MODEL=gpt-4o-mini
# Required to publish. Empty key marks rewrite fallback=true and the item is never published.
CHAT_AI_KEY=

# --- Publish target ---------------------------------------------------------
# Canonical public site origin used for ingest. Production refuses missing or
# loopback values (see worker/src/config.ts requireBvBaseUrl). Leave empty in
# local non-production so the worker fail-closes instead of hitting 127.0.0.1.
BV_BASE_URL=
# Shared secret required by the ingest endpoint. Do not commit a real value.
# Worker sends Authorization: Bearer plus x-ingest-key. Missing config is 500, bad key is 401.
NEWSROOM_INGEST_KEY=

# --- Supervisor / human-in-the-loop ----------------------------------------
# true  -> items with ai_score >= 80 publish automatically
# false -> every item waits for an editor's /approve or /publish on Telegram
AUTO_PUBLISH=false
# Comma-separated Telegram chat IDs allowed to send commands (optional).
TELEGRAM_ALLOWED_CHAT_IDS=
# Telegram bot token for the editorial command channel (optional).
TELEGRAM_BOT_TOKEN=
# Telegram channel/chat id to broadcast published items to (optional).
TELEGRAM_CHANNEL_ID=

# --- Social broadcast credentials (optional; missing => platform skipped) ---
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# --- Media (optional) -------------------------------------------------------
PEXELS_API_KEY=

# --- Supabase (pipeline run log + idempotency) ------------------------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=