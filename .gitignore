# --- Root ignore ---
.DS_Store
Thumbs.db
*.log
*.tmp
.env
.env.local
!.env.example

# --- Backend ---
backend/pb_data/
backend/pb_data_test/
backend/pb_public/
backend/pb_migrations/*.bak
backend/bv-pocketbase
*.db
*.db-shm
*.db-wal

# --- Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/

# --- Flutter / Dart ---
mobile_monorepo/**/build/
mobile_monorepo/**/.dart_tool/
mobile_monorepo/**/.flutter-plugins*
mobile_monorepo/**/.packages
mobile_monorepo/**/.pub-cache/
mobile_monorepo/**/android/.gradle/
mobile_monorepo/**/android/local.properties
*.iml

# --- Android build output ---
*.apk
*.aab
*.ap_

# --- Secrets (defense-in-depth) ---
# NOTE: .jks + key.properties are DELIBERATELY committed for turnkey CI signing
# while this repo is PRIVATE (see android_keystore/README.md). google-services.json
# would be a NEW secret per-app (Firebase) — block it by default; none exists today.
**/google-services.json

# --- Signing: turnkey APK build-এর জন্য keystore/key.properties commit হয় (ইচ্ছাকৃত) ---
# পুরনো ignore নিয়ম সরানো হয়েছে — .jks এবং key.properties এখন versioned।
# পাবলিক প্রকাশের আগে নিজের নতুন keystore বানান (android_keystore/README.md দেখুন)।

# --- Editor ---
.idea/
.vscode/
*.swp

# --- TS build cache ---
*.tsbuildinfo

# --- Signing + mobile source: committed while repo is PRIVATE (turnkey CI) ---
# keystore (.jks) + key.properties + mobile_monorepo/ are versioned so the
# Build APKs workflow can sign and build without secrets. Re-ignore them
# BEFORE making this repo public (see android_keystore/README.md).
