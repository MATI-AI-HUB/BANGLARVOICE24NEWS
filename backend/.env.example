# Banglar Voice backend — environment configuration
# Copy to .env and fill real values. All integrations are OPTIONAL:
# without a key the matching tier is skipped (cascade falls through).

# --- PocketBase ---
PB_HOST=0.0.0.0
PB_PORT=8090

# --- AI 3-tier cascade (at least one required for ingestion) ---
# Tier 1: Groq (primary) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 2: Google Gemini 1.5 Flash free — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tier 3: Cloudflare Workers AI (free 10k inferences/day).
# Format: <account_id>:<api_token>
CF_API_KEY=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- Ingest ---
# Set RSS_INGEST=1 to enable the 5-minute cron feed poller.
RSS_INGEST=1

# --- Frontend ISR revalidation (Next.js) ---
# Webhook URL that revalidates / (and /article/[slug]) after publish.
ISR_WEBHOOK_URL=

# --- Cloudflare R2 encrypted daily SQLite backup ---
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=banglar-voice-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=change-me-strong-passphrase
BACKUP_KEEP_DAYS=14

# --- Billing / payments (all optional; without keys the UI shows mock mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_MERCHANT_ID=
BKASH_APP_SECRET=

# --- Email (newsletter + notifications; without key: dry-run to stdout) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Banglar Voice <no-reply@example.com>"
