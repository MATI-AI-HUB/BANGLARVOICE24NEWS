name: Build APKs

# Sequential build of the 5 Banglar Voice Flutter apps on every push/tag.
# Why sequential (not a 4/5-job matrix): on GitHub's free runners, heavy
# Flutter+Gradle builds running in PARALLEL starve each other's CPU and hang
# in "flutter build apk" with no log output for hours. Running apps one after
# another reuses the same runner's Gradle/Flutter cache, so later builds are
# much faster and never contend.
#
# studio_app (Breaking Live Studio control room) is built in its OWN job so a
# problem there can never break the 4 main apps' build, and vice versa.
#
# Keystore is loaded from GitHub Secrets (ANDROID_KEYSTORE_BASE64) at runtime.
# It is NEVER committed to the repository.

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

# একই ref-এ একাধিক push হলে পুরোনো রান auto-cancel হয়ে নতুন রান চলে।
concurrency:
  group: apk-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    timeout-minutes: 120
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Decode keystore from GitHub Secrets
        run: |
          set -euo pipefail
          # Create keystore directory in the first app (shared across builds)
          mkdir -p mobile_monorepo/apps/reader_app/android/app/keystore
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 --decode \
            > mobile_monorepo/apps/reader_app/android/app/keystore/banglar-voice-release.jks
          echo "✅ Keystore decoded ($(wc -c < mobile_monorepo/apps/reader_app/android/app/keystore/banglar-voice-release.jks) bytes)"

      - name: Create key.properties from GitHub Secrets
        run: |
          set -euo pipefail
          apps=(reader_app admin_app reporter_app tv_app)
          for app in "${apps[@]}"; do
            cat > "mobile_monorepo/apps/$app/android/key.properties" << EOF
          storePassword=${{ secrets.KEYSTORE_PASSWORD }}
          keyPassword=${{ secrets.KEY_PASSWORD }}
          keyAlias=${{ secrets.KEY_ALIAS }}
          storeFile=keystore/banglar-voice-release.jks
          EOF
            echo "✅ key.properties created for $app"
          done

      - name: Build all 4 APKs (sequential, one runner)
        run: |
          set -euo pipefail
          apps=(reader_app admin_app reporter_app tv_app)
          targets=(lib/main.dart lib/main_admin.dart lib/main_reporter.dart lib/main_tv.dart)
          names=(reader admin reporter tv)

          mkdir -p apks

          for i in 0 1 2 3; do
            app="${apps[$i]}"
            target="${targets[$i]}"
            out="${names[$i]}"

            echo "============================================================"
            echo ">>> BUILDING $app  (target: $target)"
            echo "============================================================"

            cd "mobile_monorepo/apps/$app"
            flutter pub get

            flutter build apk --release --target "$target"

            cp build/app/outputs/flutter-apk/app-release.apk \
               "../../../apks/banglar-voice-$out-v1.0.0.apk"

            cd ../../..
            ls -la apks/
          done

      - name: Verify 4 APKs present
        run: |
          cd apks
          ls -la
          test -f banglar-voice-reader-v1.0.0.apk   || { echo "MISSING reader APK"; exit 1; }
          test -f banglar-voice-admin-v1.0.0.apk    || { echo "MISSING admin APK"; exit 1; }
          test -f banglar-voice-reporter-v1.0.0.apk || { echo "MISSING reporter APK"; exit 1; }
          test -f banglar-voice-tv-v1.0.0.apk       || { echo "MISSING tv APK"; exit 1; }
          echo "✅ ALL 4 APKs OK"

      - uses: actions/upload-artifact@v4
        with:
          name: banglar-voice-apks
          path: apks/*.apk
          retention-days: 30

      - name: Cleanup secrets from disk
        if: always()
        run: |
          find mobile_monorepo -name "banglar-voice-release.jks" -delete 2>/dev/null || true
          find mobile_monorepo -name "key.properties" -delete 2>/dev/null || true
          echo "🧹 Keystore and key.properties removed from runner"

  # ─────────────────────────────────────────────────────────────
  # studio_app built separately so it can never break / be broken
  # by the 4-app job.
  # ─────────────────────────────────────────────────────────────
  build-studio:
    timeout-minutes: 120
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Decode keystore from GitHub Secrets
        run: |
          set -euo pipefail
          mkdir -p mobile_monorepo/apps/studio_app/android/app/keystore
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 --decode \
            > mobile_monorepo/apps/studio_app/android/app/keystore/banglar-voice-release.jks
          echo "✅ Keystore decoded for studio_app"

      - name: Create key.properties for studio_app
        run: |
          set -euo pipefail
          cat > mobile_monorepo/apps/studio_app/android/key.properties << EOF
          storePassword=${{ secrets.KEYSTORE_PASSWORD }}
          keyPassword=${{ secrets.KEY_PASSWORD }}
          keyAlias=${{ secrets.KEY_ALIAS }}
          storeFile=keystore/banglar-voice-release.jks
          EOF
          echo "✅ key.properties created for studio_app"

      - name: Build studio APK (Breaking Live Studio)
        run: |
          set -euo pipefail
          cd mobile_monorepo/apps/studio_app
          flutter pub get

          flutter build apk --release --target lib/main_studio.dart

          mkdir -p ../../../apks
          cp build/app/outputs/flutter-apk/app-release.apk \
             ../../../apks/banglar-voice-studio-v1.0.0.apk
          echo "✅ Studio APK built"

      - uses: actions/upload-artifact@v4
        with:
          name: banglar-voice-studio-apk
          path: apks/banglar-voice-studio-v1.0.0.apk
          retention-days: 30

      - name: Cleanup secrets from disk
        if: always()
        run: |
          find mobile_monorepo -name "banglar-voice-release.jks" -delete 2>/dev/null || true
          find mobile_monorepo -name "key.properties" -delete 2>/dev/null || true
          echo "🧹 Keystore and key.properties removed from runner"
