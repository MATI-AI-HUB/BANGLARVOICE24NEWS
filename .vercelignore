# Vercel root-dir ignore — when importing the repo, set Root Directory = frontend
# and this file (kept at repo root) prevents stray files from being published if
# you ever deploy the monorepo root instead.

# Flutter / mobile build output
mobile_monorepo/
android_keystore/

# Go backend
backend/
docs/

# Local Next.js output
node_modules/
.next/
out/

# Env / secrets
.env
.env.local
