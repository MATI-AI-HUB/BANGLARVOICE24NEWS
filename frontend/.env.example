# Banglar Voice — Next.js frontend environment template
# Copy to .env.local for local dev. Vercel: add these in Project → Settings → Environment Variables.

# Backend (PocketBase) base URL. In production point this at your deployed backend.
#   Local dev (backend on same machine):  http://127.0.0.1:8090
#   Android emulator hits host via:       http://10.0.2.2:8090
#   Render free web service example:      https://banglar-voice-backend.onrender.com
#   Oracle/VPS with domain:               https://api.banglarvoice24news.com
#
# IMPORTANT: no trailing slash. The Next.js rewrite in next.config.js proxies
# /api/backend/* -> {NEXT_PUBLIC_API_URL}/api/* so browser code never calls the
# backend cross-origin in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8090
