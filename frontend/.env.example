# Banglar Voice — Next.js frontend environment template
# Copy to .env.local for local dev. Vercel: add these in Project → Settings → Environment Variables.
#
# Production public site uses Supabase. Do not point production at loopback.
# Canonical site: https://banglarvoice24news.com
# Public feed:    /api/public/feed.json

# Public site origin (no trailing slash). Used by sitemap/feed absolute URLs.
NEXT_PUBLIC_SITE_URL=https://banglarvoice24news.com

# Supabase (required for production articles, ticker, and public feed).
# Copy from Supabase: Project Settings → API. Anon key is browser-safe (RLS).
# Leave URL/key unset locally only if you are not hitting the live newsroom.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional legacy e-paper API origin. Leave empty unless a dedicated e-paper
# service is configured. Production must not fall back to loopback.
# Local rewrite /api/backend/* is gated by ENABLE_LEGACY_POCKETBASE=true and
# is disabled when NODE_ENV=production.
NEXT_PUBLIC_API_URL=

# Server-only. Required by admin APIs and POST /api/newsroom/ingest.
# Never expose to the browser. Leave unset locally if not ingesting.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for worker POST /api/newsroom/ingest.
# Send Authorization: Bearer <NEWSROOM_INGEST_KEY> (x-ingest-key still accepted).
# Missing/change-me → HTTP 500 ingest_unconfigured. Wrong key → HTTP 401.
NEWSROOM_INGEST_KEY=

NEXT_PUBLIC_SENTRY_DSN="https://dummy@sentry.io/123"
